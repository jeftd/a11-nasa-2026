# Copy this file to .env and fill in your own values. Never commit .env.

# NASA FIRMS API key (free). Request one at:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Used for: recent NRT hotspots (last days) and VIIRS NOAA-21, which is not
# available in the public country yearly CSV files.
FIRMS_MAP_KEY=

# Base URL of the FIRMS API (normally no need to change)
FIRMS_API_BASE=https://firms.modaps.eosdis.nasa.gov/api
