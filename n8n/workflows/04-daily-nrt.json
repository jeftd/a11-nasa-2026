    "List sources": {
      "main": [
        [
          {
            "node": "Load each",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load each": {
      "main": [
        [
          {
            "node": "Refresh grid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh grid": {
      "main": [
        [
          {
            "node": "Finish run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
