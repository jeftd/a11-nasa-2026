{
  "name": "A11 Daily NRT (Mexico)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6
            }
          ]
        }
      },
      "name": "Every day 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Last 2 days of Near Real-Time hotspots over Mexico. Duplicates are ignored by the database.\nconst BBOX = '-118.5,14.5,-86.7,32.8';\nconst api = 'https://firms.modaps.eosdis.nasa.gov/api/area/csv';\nreturn ['MODIS_NRT', 'VIIRS_NOAA20_NRT', 'VIIRS_NOAA21_NRT'].map(s => ({ json: {\n  url: `${api}/{KEY}/${s}/${BBOX}/2`,\n  source: `api:${s}/${BBOX}/2@${new Date().toISOString().slice(0, 10)}`,\n  processing: 'NRT',\n  country: 'Mexico (bbox)',\n}}));"
      },
      "name": "List sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "g8PK6cZ7WiIK8N3w"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "name": "Load each",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM refresh_after_load();",
        "options": {}
      },
      "name": "Refresh grid",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "vc9QesVEe9bgweDY",
          "name": "a11-db"
        }
      },
      "executeOnce": true
    }
  ],
  "connections": {
