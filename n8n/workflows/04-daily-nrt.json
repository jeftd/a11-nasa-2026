{
  "name": "A11 Daily NRT (Mexico + US)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6
            }
          ]
        }
      },
      "name": "Every day 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT start_pipeline_run('daily_nrt', '{{ $execution.mode }}', '{{ $execution.id }}') AS run_id;",
        "options": {}
      },
      "name": "Start run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "vc9QesVEe9bgweDY",
          "name": "a11-db"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const runId = $('Start run').first().json.run_id;\n// Last 2 days of Near Real-Time hotspots over Mexico and the United States. Duplicates are ignored by the database.\nconst REGIONS = [['Mexico (bbox)', '-118.5,14.5,-86.7,32.8'],\n                 ['United_States (bbox)', '-125,24.4,-66.9,49.5'],\n                 ['United_States (bbox)', '-170,51,-129.9,71.5']];\nconst api = 'https://firms.modaps.eosdis.nasa.gov/api/area/csv';\nconst day = new Date().toISOString().slice(0, 10);\nreturn REGIONS.flatMap(([country, BBOX]) => ['MODIS_NRT', 'VIIRS_NOAA20_NRT', 'VIIRS_NOAA21_NRT'].map(s => ({ json: {\n  url: `${api}/{KEY}/${s}/${BBOX}/2`,\n  source: `api:${s}/${BBOX}/2@${day}`,\n  processing: 'NRT',\n  country,\n  run_id: runId,\n}})));"
      },
      "name": "List sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "g8PK6cZ7WiIK8N3w"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "name": "Load each",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM refresh_after_load();",
        "options": {}
      },
      "name": "Refresh grid",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "vc9QesVEe9bgweDY",
          "name": "a11-db"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM finish_pipeline_run({{ $('Start run').first().json.run_id }}, {{ $('List sources').all().length }}, {{ $json.nrt_removed ?? 'NULL' }});",
        "options": {}
      },
      "name": "Finish run",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "vc9QesVEe9bgweDY",
          "name": "a11-db"
        }
      },
      "executeOnce": true
    }
  ],
  "connections": {
    "Every day 06:00": {
      "main": [
        [
          {
            "node": "Start run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start run": {
