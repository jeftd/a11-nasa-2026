{
  "name": "A11 Pipeline error handler",
  "nodes": [
    {
      "parameters": {},
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT * FROM fail_pipeline_run('{{ $json.execution.id }}', $msg${{ $json.execution.lastNodeExecuted }}: {{ $json.execution.error.message }}$msg$);",
        "options": {}
      },
      "name": "Mark run failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "vc9QesVEe9bgweDY",
          "name": "a11-db"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Mark run failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}