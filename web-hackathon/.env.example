# Production n8n webhook URL of the assistant workflow (server-side only)
N8N_WEBHOOK_URL=https://n8n-n8n.example.easypanel.host/webhook/a11-chat
# Shared secret sent as the X-Webhook-Secret header; n8n rejects requests without it
N8N_WEBHOOK_SECRET=change-me
PORT=3000
# Read-only Postgres role for the harmonized data API (optional; without it the site serves the fake files)
DATABASE_URL=postgres://a11_web:change-me@learn_a11-db:5432/firms
