PORT=3000
# Read-only Postgres role for the harmonized data API (optional; without it the site serves the fake files)
DATABASE_URL=postgres://a11_web:change-me@learn_a11-db:5432/firms

# ---- Ember assistant: LangChain agent (chat-agent.js) ----
# Any OpenAI-compatible chat API that supports tool calling. Default: MiniMax (international endpoint).
LLM_API_KEY=your-minimax-api-key
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M2.7-highspeed
# Optional: LLM_TEMPERATURE=0.3 (low on purpose: answers stick to the data and docs)
# Optional memory compaction thresholds: CHAT_COMPACT_ROWS=30, CHAT_COMPACT_CHARS=24000
# Memory: uses DATABASE_URL (a11_web may write chat_messages, see analysis/db/chat_memory.sql).
# Set CHAT_DATABASE_URL only to keep the chats in another database or role. Without a database: in-memory.
# CHAT_DATABASE_URL=postgres://...
# Document search (RAG) over knowledge/*.md: OpenAI embeddings, vectors in the rag_chunks table (analysis/db/rag.sql).
# Without it Ember works but has no search_docs tool.
OPENAI_API_KEY=your-openai-api-key
# Optional: EMBEDDINGS_MODEL=text-embedding-3-small
# "langchain" (default when LLM_API_KEY is set) or "n8n" to go back to the webhook below.
# CHAT_BACKEND=langchain

# ---- Old backend (CHAT_BACKEND=n8n) ----
N8N_WEBHOOK_URL=https://n8n-n8n.example.easypanel.host/webhook/a11-chat
N8N_WEBHOOK_SECRET=change-me
